# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered
CONTACT_TO=-------

# Sender address. onboarding@resend.dev works out of the box but can ONLY
# deliver to the email on your Resend account. Once you verify
# victoronofiok.com in Resend, switch this to e.g. hello@victoronofiok.com
CONTACT_FROM=Portfolio <onboarding@resend.dev>
